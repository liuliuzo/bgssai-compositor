{
  "name": "bgssai-compositor",
  "version": "0.2.0",
  "description": "Offline layer editor for Windows, macOS, Linux, iOS and Android",
  "private": true,
  "type": "module",
  "author": "BGSSAI <hello@bgssai.com>",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:shared && tsc --noEmit && vite build",
    "test": "npm run build:shared && tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:dev": "node scripts/smoke-dev.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "test:portable": "node scripts/smoke-portable.mjs",
    "check": "npm run test && npm run build && npm run test:e2e",
    "dist:win": "npm run build && electron-builder --win --x64",
    "start": "electron .",
    "build:shared": "esbuild src/project.ts --bundle --platform=node --format=cjs --outfile=electron/project-validator.cjs",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "dist:linux": "npm run build && electron-builder --linux --x64",
    "mobile:sync": "npm run build && cap sync",
    "service": "node service/server.mjs",
    "release:manifest": "node scripts/release-manifest.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@electron/get": "^5.1.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "esbuild": "^0.28.2"
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "build": {
    "appId": "com.bgssai.compositor",
    "productName": "BGSSAI Compositor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "config/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BGSSAI-Compositor-${version}-win-${arch}-setup.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "BGSSAI-Compositor-${version}-win-${arch}-portable.exe"
    },
    "fileAssociations": [
      {
        "ext": "bgcomp",
        "name": "BGSSAI Compositor Project",
        "role": "Editor",
        "mimeType": "application/x-bgcomp"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "artifactName": "BGSSAI-Compositor-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "notarize": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "artifactName": "BGSSAI-Compositor-${version}-linux-${arch}.${ext}",
      "icon": "build/icon.png"
    }
  }
}
